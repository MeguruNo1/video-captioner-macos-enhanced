# VideoCaptioner Gitignore
# Root may contain local runtimes, binaries, and user data.
# Ignore everything at root, then selectively un-ignore source files.

# Ignore everything at root level by default
*

# === Source code (tracked) ===
!/.gitignore
!/README.md
!/Agent.md
!/README.en.md
!/README-macos-whisperx.md
!/main.py
!/requirements-macos-whisperx.txt
!/requirements-common.txt
!/requirements-windows.txt
!/VideoCaptioner.bat
!/app/
!/app/**
!/tests/
!/tests/**
!/scripts/
!/scripts/**
!/docs/
!/docs/superpowers/
!/docs/superpowers/specs/
!/docs/superpowers/specs/**
!/docs/superpowers/plans/
!/docs/superpowers/plans/**

# === macOS build artifacts ===
/build/
/dist/
/*.app/

# === Python cache ===
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.dylib
*.pyo

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo
*~

# === OS generated ===
.DS_Store
Thumbs.db

# === Virtual environments ===
venv/
.venv/
env/

# === Environment / secrets ===
.env
.env.local
*.secret

# === App-specific directories (ignored) ===
/AppData/
/resource/
!/resource/
/resource/*
!/resource/assets/
/resource/assets/*
!/resource/assets/logo.png
/runtime/
/work-dir/
/VideoCapitoner/

# === Installer artifacts (ignored) ===
/unins000.dat
/unins000.exe
